#!/usr/bin/env bash
# agent-status -- per-pane coding-agent state for tmux.
#
#   agent-status set <working|waiting|done> [--agent NAME] [--msg TEXT]
#   agent-status clear            drop this pane's record (agent exited)
#   agent-status seen [PANE]      clear a "done" the user is now looking at
#   agent-status refresh          gc dead panes, rebuild bar + window markers
#   agent-status list             TSV for fzf: pane <TAB> display line
#   agent-status pick [CLIENT]    fzf popup over all agents, jump on <enter>
#   agent-status jump next [CLIENT] [CURRENT_PANE]
#
# State lives in $XDG_RUNTIME_DIR/agent-status/<tmux-socket>_<pane-number>,
# one line: state TAB agent TAB since TAB work-start TAB message.
# Every command is a silent no-op outside tmux. See README.md.

set -u
umask 077

[ -n "${TMUX:-}" ] || exit 0
_sock=${TMUX%%,*}
SOCK=${_sock##*/}
DIR=${AGENT_STATUS_DIR:-${XDG_RUNTIME_DIR:-/tmp}/agent-status-$UID}
[ -d "$DIR" ] || mkdir -p "$DIR" 2>/dev/null || exit 0

SELF=$(readlink -f "${BASH_SOURCE[0]}")
printf -v NOW '%(%s)T' -1

# ---------------------------------------------------------------- options --
declare -A OPT
OPTS_LOADED=0
load_opts() {
  [ "$OPTS_LOADED" = 1 ] && return
  OPTS_LOADED=1
  local k v
  while read -r k v; do
    case $k in @agent-status-*) v=${v#[\"\']}; v=${v%[\"\']}; OPT[${k#@agent-status-}]=$v ;; esac
  done < <(tmux show-options -g 2>/dev/null)
}
opt() { load_opts; printf '%s' "${OPT[$1]:-$2}"; }
truthy() { case "${1,,}" in 1|on|yes|true) return 0 ;; esac; return 1; }

# ---------------------------------------------------------------- records --
rec_path() { REC="$DIR/${SOCK}_${1#%}"; }
R_STATE= R_AGENT= R_SINCE= R_WSTART= R_MSG=
read_rec() {
  R_STATE= R_AGENT= R_SINCE= R_WSTART= R_MSG=
  [ -r "$1" ] || return 1
  IFS=$'\t' read -r R_STATE R_AGENT R_SINCE R_WSTART R_MSG <"$1" || [ -n "$R_STATE" ]
}
write_rec() { # path state agent since wstart msg
  local tmp="$1.$$"
  printf '%s\t%s\t%s\t%s\t%s\n' "$2" "$3" "$4" "$5" "$6" >"$tmp" && mv -f "$tmp" "$1"
}

# ------------------------------------------------------------- tmux state --
declare -A P_WIN P_LOC P_CMD
load_panes() {
  local pid win loc cmd
  P_WIN=() P_LOC=() P_CMD=()
  while IFS=$'\t' read -r pid win loc cmd; do
    P_WIN[$pid]=$win P_LOC[$pid]=$loc P_CMD[$pid]=$cmd
  done < <(tmux list-panes -a -F \
    "#{pane_id}"$'\t'"#{window_id}"$'\t'"#{session_name}:#{window_index}.#{pane_index}"$'\t'"#{pane_current_command}" 2>/dev/null)
}

# Is the user looking at this pane right now?
focused() {
  if [ -n "${AGENT_STATUS_FOCUSED:-}" ]; then [ "$AGENT_STATUS_FOCUSED" = 1 ]; return; fi
  [ "$(tmux display-message -p -t "$1" \
    '#{&&:#{&&:#{pane_active},#{window_active}},#{session_attached}}' 2>/dev/null)" = 1 ]
}

is_shell() { case "$1" in bash|zsh|fish|sh|dash|ksh|tcsh|nu|login) return 0 ;; esac; return 1; }

# Fill RECS with "rank TAB since TAB pane TAB state TAB agent TAB msg" for every
# live record; drop records whose pane vanished or fell back to a shell.
RECS=()
declare -A KNOWN
scan() {
  load_panes
  RECS=() KNOWN=()
  local f n pane rank
  for f in "$DIR/${SOCK}_"*; do
    [ -e "$f" ] || continue
    n=${f##*/}; n=${n#"${SOCK}_"}
    [[ $n =~ ^[0-9]+$ ]] || continue
    pane="%$n"
    if [ -z "${P_WIN[$pane]:-}" ] || is_shell "${P_CMD[$pane]}"; then
      rm -f "$f" "$f.n"; continue
    fi
    read_rec "$f" || continue
    case $R_STATE in
      waiting) rank=0 ;; done) rank=1 ;; working) rank=2 ;;
      *) rm -f "$f"; continue ;;
    esac
    RECS+=("$rank"$'\t'"$R_SINCE"$'\t'"$pane"$'\t'"$R_STATE"$'\t'"$R_AGENT"$'\t'"$R_MSG")
    KNOWN[$pane]=1
  done
  # Agents that never reported (started before the adapter, or no adapter) still
  # show up in the list, found by process name.
  local names=" $(opt agents 'pi claude codex opencode') "
  for pane in "${!P_WIN[@]}"; do
    [ -n "${KNOWN[$pane]:-}" ] && continue
    case $names in *" ${P_CMD[$pane]} "*) RECS+=("3"$'\t'"0"$'\t'"$pane"$'\t'"running"$'\t'"${P_CMD[$pane]}"$'\t'"") ;; esac
  done
}

sorted_recs() {
  [ ${#RECS[@]} -gt 0 ] || return 0
  printf '%s\n' "${RECS[@]}" | sort -t$'\t' -k1,1n -k2,2n -k3.2,3n
}

# Recompute the status-bar summary and per-window markers.
refresh() {
  if command -v flock >/dev/null 2>&1; then exec 9>"$DIR/.lock"; flock -w 3 9 || true; fi
  scan
  local waiting=0 done_=0 line pane st win
  declare -A mark
  for line in "${RECS[@]}"; do
    IFS=$'\t' read -r _ _ pane st _ <<<"$line"
    win=${P_WIN[$pane]}
    case $st in
      waiting) waiting=$((waiting + 1)); mark[$win]=w ;;
      done)    done_=$((done_ + 1)); [ "${mark[$win]:-}" = w ] || mark[$win]=d ;;
    esac
  done

  local iw idn cw cd
  iw=$(opt icon-waiting '⚠'); idn=$(opt icon-done '✓')
  cw=$(opt color-waiting yellow); cd=$(opt color-done green)

  local sum=""
  [ "$waiting" -gt 0 ] && sum+="#[fg=$cw,bold]$iw$waiting#[default] "
  [ "$done_" -gt 0 ]   && sum+="#[fg=$cd]$idn$done_#[default] "

  local -a args=()
  local -A seenw=()
  for pane in "${!P_WIN[@]}"; do
    win=${P_WIN[$pane]}
    [ -n "${seenw[$win]:-}" ] && continue
    seenw[$win]=1
    case ${mark[$win]:-} in
      w) args+=(set-option -w -t "$win" @agent_mark "#[fg=$cw,bold]$iw#[default]" ';') ;;
      d) args+=(set-option -w -t "$win" @agent_mark "#[fg=$cd]$idn#[default]" ';') ;;
      *) args+=(set-option -wu -t "$win" @agent_mark ';') ;;
    esac
  done
  tmux "${args[@]}" set-option -g @agent_summary "$sum" ';' refresh-client -S 2>/dev/null
}

# ---------------------------------------------------------- notifications --
notify() { # pane state agent msg
  local pane=$1 state=$2 agent=$3 msg=$4 title body loc
  loc=$(tmux display-message -p -t "$pane" '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null)
  case $state in
    waiting) title="$agent needs you" ;;
    done)    title="$agent finished" ;;
    *) return ;;
  esac
  body="$loc${msg:+ — $msg}"
  if truthy "$(opt tmux-message off)"; then
    local c
    while read -r c; do tmux display-message -c "$c" -d 5000 "$title  ($body)" 2>/dev/null; done \
      < <(tmux list-clients -F '#{client_name}' 2>/dev/null)
  fi
  if [ -n "${AGENT_STATUS_NOTIFY_CMD:-}" ]; then
    ( "$AGENT_STATUS_NOTIFY_CMD" "$title" "$body" >/dev/null 2>&1 & )
  elif command -v omarchy-notification-send >/dev/null 2>&1; then
    # Omarchy toast: urgency per state, glyph, click jumps to the pane.
    local urg glyph
    if [ "$state" = waiting ]; then urg=$(opt urgency-waiting critical); glyph=$(opt glyph-waiting '󰀪')
    else urg=$(opt urgency-done normal); glyph=$(opt glyph-done '󰄬'); fi
    ( omarchy-notification-send --app-name tmux-agent-status -u "$urg" -g "$glyph" "$title" "$body" \
        --exec env "TMUX=$TMUX" "$SELF" jump pane "$pane" >/dev/null 2>&1 & )
  elif command -v notify-send >/dev/null 2>&1; then
    ( timeout 3 notify-send -a tmux-agent-status -u normal "$title" "$body" >/dev/null 2>&1 & )
  fi
}

should_notify() { # pane state prev wstart
  local pane=$1 state=$2 prev=$3 wstart=$4
  truthy "$(opt notify on)" || return 1
  case $state in
    waiting) [ "$prev" != waiting ] || return 1 ;;
    done)
      truthy "$(opt notify-done off)" || return 1
      [ $((NOW - wstart)) -ge "$(opt notify-done-min-secs 0)" ] || return 1 ;;
    *) return 1 ;;
  esac
  focused "$pane" && return 1
  local stamp last=0
  rec_path "$pane"; stamp="$REC.n"
  [ -r "$stamp" ] && read -r last <"$stamp"
  [ $((NOW - last)) -ge "$(opt debounce 10)" ] || return 1
  printf '%s\n' "$NOW" >"$stamp"
  return 0
}

# --------------------------------------------------------------- commands --
cmd_set() {
  local state=${1:-}; shift || true
  local agent="" msg=""
  while [ $# -gt 0 ]; do
    case $1 in
      --agent) agent=${2:-}; shift 2 ;;
      --msg)   msg=${2:-};   shift 2 ;;
      *) shift ;;
    esac
  done
  case $state in working|waiting|done) ;; *) echo "agent-status: bad state '$state'" >&2; exit 2 ;; esac
  local pane=${AGENT_STATUS_PANE:-${TMUX_PANE:-}}
  [ -n "$pane" ] || exit 0
  rec_path "$pane"
  local f=$REC prev="" since=$NOW wstart=$NOW
  if read_rec "$f"; then
    prev=$R_STATE
    [ -n "$agent" ] || agent=$R_AGENT
    wstart=$R_WSTART
  fi
  [ -n "$agent" ] || agent=agent
  [ "$prev" = "$state" ] && exit 0            # unchanged: hot path for tool hooks
  [ "$state" = working ] && wstart=$NOW
  [ -n "$wstart" ] || wstart=$NOW
  msg=${msg//[$'\t\n\r']/ }; msg=${msg:0:200}

  # Finished while the user is watching: nothing to report.
  if [ "$state" = done ] && focused "$pane"; then
    rm -f "$f"
  else
    write_rec "$f" "$state" "$agent" "$since" "$wstart" "$msg"
  fi
  should_notify "$pane" "$state" "$prev" "$wstart" && notify "$pane" "$state" "$agent" "$msg"
  refresh
}

cmd_clear() {
  local pane=${AGENT_STATUS_PANE:-${TMUX_PANE:-}}
  [ -n "$pane" ] || exit 0
  rec_path "$pane"
  [ -e "$REC" ] || exit 0
  rm -f "$REC" "$REC.n"
  refresh
}

cmd_seen() {
  local pane=${1:-}
  [ -n "$pane" ] || pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null)
  [ -n "$pane" ] || exit 0
  rec_path "$pane"
  [ -e "$REC" ] || exit 0                     # fast exit: nothing recorded
  read_rec "$REC" || exit 0
  [ "$R_STATE" = done ] || exit 0
  focused "$pane" || exit 0
  rm -f "$REC"
  refresh
}

cmd_list() {
  refresh
  local line rank since pane st agent msg icon col loc age d
  local iw idn cw cd
  iw=$(opt icon-waiting '⚠'); idn=$(opt icon-done '✓')
  cw=31; cd=32
  while IFS=$'\t' read -r rank since pane st agent msg; do
    [ -n "$pane" ] || continue
    d=$((NOW - since))
    if   [ "$since" = 0 ]; then age="-"
    elif [ $d -lt 60 ];   then age="${d}s"
    elif [ $d -lt 3600 ]; then age="$((d / 60))m"
    else age="$((d / 3600))h"; fi
    loc=${P_LOC[$pane]:-?}
    case $st in
      waiting) icon=$iw;  col="\033[1;33m" ;;
      done)    icon=$idn; col="\033[32m" ;;
      working) icon="●";  col="\033[36m" ;;
      *)       icon="○";  col="\033[2m" ;;
    esac
    printf "%s\t${col}%s %-8s\033[0m %-24s %5s  %s\n" "$pane" "$icon" "$agent" "$loc" "$age" "$msg"
  done < <(sorted_recs)
}

# A client name that is empty or an unexpanded "#{...}" format is unusable:
# fall back to the most recently active client.
resolve_client() {
  case ${1:-} in
    ""|*'#{'*) tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2- ;;
    *) printf '%s' "$1" ;;
  esac
}

jump_to() { # pane [client]
  local pane=$1 client sess win
  client=$(resolve_client "${2:-}")
  sess=$(tmux display-message -p -t "$pane" '#{session_id}' 2>/dev/null) || return 1
  win=$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null) || return 1
  [ -n "$sess" ] || return 1
  tmux switch-client ${client:+-c "$client"} -t "$sess" ';' \
       select-window -t "$win" ';' select-pane -t "$pane"
}

# Best effort: raise the Hyprland window hosting this tmux client.
focus_terminal() { # client
  command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  local pid addr
  pid=$(tmux display-message -p -c "$1" '#{client_pid}' 2>/dev/null)
  while [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
    addr=$(hyprctl clients -j 2>/dev/null | jq -r --argjson p "$pid" '.[] | select(.pid == $p) | .address' 2>/dev/null | head -1)
    if [ -n "$addr" ]; then hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1; return 0; fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  done
}

cmd_pick() {
  local client=${1:-} out pane
  out=$(cmd_list)
  if [ -z "$out" ]; then
    printf 'no agents running\n'; sleep 1; exit 0
  fi
  pane=$(printf '%s\n' "$out" | fzf --ansi --delimiter=$'\t' --with-nth=2.. \
      --no-sort --reverse --prompt='agent> ' --header='enter: jump  esc: close' \
      --preview="tmux capture-pane -ep -t {1} | tail -n 40" \
      --preview-window=down:50%:wrap | cut -f1) || exit 0
  [ -n "$pane" ] || exit 0
  jump_to "$pane" "$client" || tmux display-message "agent-status: could not jump to $pane"
  focus_terminal "$(resolve_client "$client")"
}

cmd_jump() {
  if [ "${1:-}" = pane ]; then       # notification click: jump + raise the terminal
    local client; client=$(resolve_client "${3:-}")
    jump_to "${2:-}" "$client" && [ -n "$client" ] && focus_terminal "$client"
    exit 0
  fi
  [ "${1:-next}" = next ] || { echo "usage: jump next|pane ..." >&2; exit 2; }
  local client=${2:-} cur=${3:-} rank since pane st first="" pick=""
  scan
  while IFS=$'\t' read -r rank since pane st _; do
    [ "$rank" -lt 2 ] || continue
    [ -n "$first" ] || first=$pane
    if [ "$pane" != "$cur" ]; then pick=$pane; break; fi
  done < <(sorted_recs)
  pick=${pick:-$first}
  if [ -z "$pick" ]; then
    tmux display-message ${client:+-c "$client"} "agent-status: nothing needs you"
    exit 0
  fi
  jump_to "$pick" "$client"
}

case ${1:-} in
  set)     shift; cmd_set "$@" ;;
  clear)   cmd_clear ;;
  seen)    shift; cmd_seen "$@" ;;
  refresh) refresh ;;
  list)    cmd_list ;;
  pick)    shift; cmd_pick "$@" ;;
  jump)    shift; cmd_jump "$@" ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
